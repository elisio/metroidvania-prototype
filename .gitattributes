# Normaliza texto para LF no repositório e na cópia de trabalho.
* text=auto eol=lf

*.js   text eol=lf
*.html text eol=lf
*.css  text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.py   text eol=lf
*.sh   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf

# Binários: sem diff textual, sem conversão de fim de linha.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.ogg  binary
*.mp3  binary
*.wav  binary
*.woff binary
*.woff2 binary
